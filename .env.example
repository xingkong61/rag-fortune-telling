# 复制为 .env 并填入真实值
DASHSCOPE_API_KEY=

# Qwen 模型 ID（以 DashScope 控制台为准）
LLM_MODEL_FLASH=qwen3.8-flash
LLM_MODEL_MAX=qwen3.8-max

EMBED_MODEL=text-embedding-v3

# 单次 LLM 请求超时（秒），需小于反代（如 Cloudflare）100 秒源站超时
LLM_TIMEOUT=60

# 是否启用模型思考模式：false（默认）时首字约 1 秒返回；true 会先输出长思维链，
# 首字可能延迟到近百秒，仅在需要更强推理时开启
LLM_ENABLE_THINKING=false

RAG_TOP_K=8
RAG_MIN_SCORE=0.35
CHROMA_DIR=data/chroma